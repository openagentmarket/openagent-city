rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isCodexCityRoom(roomId) {
      return roomId == "codex-city";
    }

    function isCodexCityRoomData() {
      return request.resource.data.keys().hasOnly([
        "name",
        "visibility",
        "createdByUid",
        "updatedAt"
      ])
      && request.resource.data.name == "Codex City"
      && request.resource.data.visibility == "public"
      && request.resource.data.createdByUid is string;
    }

    function isParticipantData(uid) {
      return request.resource.data.keys().hasOnly([
        "ownerUid",
        "petId",
        "displayName",
        "description",
        "status",
        "animationState",
        "spritesheetUrl",
        "packageUrl",
        "frameWidth",
        "frameHeight",
        "joinedAt",
        "updatedAt"
      ])
      && request.resource.data.ownerUid == uid
      && request.resource.data.petId is string
      && request.resource.data.displayName is string
      && request.resource.data.description is string
      && (!request.resource.data.keys().hasAny(["status"]) || request.resource.data.status is string)
      && (!request.resource.data.keys().hasAny(["animationState"]) || request.resource.data.animationState is string)
      && request.resource.data.spritesheetUrl is string
      && (!request.resource.data.keys().hasAny(["packageUrl"]) || request.resource.data.packageUrl is string)
      && request.resource.data.frameWidth is number
      && request.resource.data.frameHeight is number;
    }

    function isPetAssetData(assetHash) {
      return request.resource.data.keys().hasOnly([
        "contentHash",
        "spritesheetHash",
        "petJsonHash",
        "storagePath",
        "spritesheetPath",
        "petJsonPath",
        "packagePath",
        "firstUploaderUid",
        "uploadCount",
        "createdAt",
        "updatedAt"
      ])
      && request.resource.data.contentHash == assetHash
      && request.resource.data.spritesheetHash is string
      && request.resource.data.petJsonHash is string
      && request.resource.data.storagePath == ("assets/" + assetHash)
      && request.resource.data.spritesheetPath is string
      && (request.resource.data.petJsonPath == null || request.resource.data.petJsonPath is string)
      && (request.resource.data.packagePath == null || request.resource.data.packagePath is string)
      && request.resource.data.firstUploaderUid is string
      && request.resource.data.uploadCount is number
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /pets/{petId} {
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;

      allow get: if request.auth != null
        && (!exists(/databases/$(database)/documents/pets/$(petId))
          || resource.data.ownerUid == request.auth.uid);

      allow list: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    match /pets/{petId}/versions/{versionId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/pets/$(petId)).data.ownerUid == request.auth.uid;
    }

    match /petAssets/{assetHash} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && isPetAssetData(assetHash)
        && request.resource.data.firstUploaderUid == request.auth.uid
        && request.resource.data.uploadCount == 1;
      allow update: if request.auth != null
        && isPetAssetData(assetHash)
        && request.resource.data.firstUploaderUid == resource.data.firstUploaderUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.uploadCount >= resource.data.uploadCount;
    }

    match /rooms/{roomId} {
      allow read: if request.auth != null
        && isCodexCityRoom(roomId);
      allow create, update: if request.auth != null
        && isCodexCityRoom(roomId)
        && isCodexCityRoomData();
    }

    match /rooms/{roomId}/participants/{uid} {
      allow read: if request.auth != null
        && isCodexCityRoom(roomId);
      allow create, update: if request.auth != null
        && isCodexCityRoom(roomId)
        && request.auth.uid == uid
        && isParticipantData(uid);
      allow delete: if request.auth != null
        && isCodexCityRoom(roomId)
        && request.auth.uid == uid
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
